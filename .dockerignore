# Flask app .dockerignore

# Exclude simulation packages (not needed for Flask)
pygmsh/
tetrax/

# Exclude job-specific files
job_runner.py
TetraxCalc.py
requirements.job.txt
requirements.dev.txt
Dockerfile.job
Dockerfile.job.dockerignore
tests/

# Exclude local/dev configs
gunicorn.local.conf.py
venv*/
__pycache__/

# Exclude data directories
simulation_data/
datastorage/

# Exclude scripts and docs
bash_scripts/
*.sh
*.md

# Exclude bytecode
*.pyc
*.pyo
*.pyd

# Exclude env and system files
.env*
.DS_Store
.git
.gitignore
