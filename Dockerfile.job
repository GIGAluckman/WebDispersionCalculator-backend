# Builder stage: compiles native wheels for tetrax/pygmsh; build-essential
# never reaches the runtime image
FROM --platform=linux/amd64 python:3.11-slim AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3-gmsh && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# The vendored libraries change rarely — keep them in early layers
WORKDIR /build
COPY pygmsh/ pygmsh/
COPY tetrax/ tetrax/
COPY requirements.job.txt .
RUN pip install --no-cache-dir -r requirements.job.txt

# Runtime stage
FROM --platform=linux/amd64 python:3.11-slim

LABEL version="1.0.0"

ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-gmsh \
        curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY job_runner.py TetraxCalc.py helpers.py df_manipulation.py /app/

# Run from /
WORKDIR /
CMD ["python", "/app/job_runner.py"]
