# Job runner .dockerignore

# Exclude Flask-specific files
app.py
app_data_proc.py
gunicorn.conf.py
gunicorn.local.conf.py
requirements.txt
requirements.dev.txt
Dockerfile
tests/

# Vendored library dead weight (tetrax/doc alone is ~200 MB)
tetrax/.git/
tetrax/build/
tetrax/doc/
tetrax/documentation/
tetrax/tests/
tetrax/logo_large.png
tetrax/**/__pycache__/
pygmsh/.git/
pygmsh/doc/
pygmsh/test/
pygmsh/tests/
pygmsh/**/__pycache__/

# Exclude local/dev configs
venv*/
__pycache__/

# Exclude data directories
simulation_data/
datastorage/

# Exclude scripts and docs
bash_scripts/
*.sh
*.md

# Exclude bytecode
*.pyc
*.pyo
*.pyd

# Exclude env and system files
.env*
.DS_Store
.git
.gitignore
